rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveRole(role) {
      return signedIn()
        && userProfile().role == role
        && userProfile().status == 'active';
    }

    function isFaculty() {
      return isActiveRole('faculty') || isActiveRole('admin');
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isFaculty());
      allow create, update, delete: if isActiveRole('admin');
    }

    match /sessions/{sessionId} {
      allow read: if signedIn()
        && (
          isFaculty()
          || (
            isActiveRole('student')
            && (
              resource.data.status == 'active'
              || resource.data.status == 'completed'
              || resource.data.status == 'stopped'
            )
            && (
              !('className' in resource.data)
              || resource.data.className == userProfile().className
              || resource.data.className == userProfile().classId
              || resource.data.className == userProfile().class
              || resource.data.className == userProfile().department
            )
            && (
              !('classId' in resource.data)
              || resource.data.classId == userProfile().classId
              || resource.data.classId == userProfile().className
              || resource.data.classId == userProfile().class
              || resource.data.classId == userProfile().department
            )
            && (
              !('semester' in resource.data)
              || resource.data.semester == userProfile().semester
            )
            && (
              !('division' in resource.data)
              || resource.data.division == userProfile().division
            )
          )
        );

      allow create: if isFaculty()
        && request.resource.data.facultyId == request.auth.uid
        && request.resource.data.status == 'active';

      allow update: if isFaculty()
        && resource.data.facultyId == request.auth.uid
        && (
          request.resource.data.status == 'completed'
          || request.resource.data.status == 'active'
        );

      allow delete: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn()
        && (
          isFaculty()
          || (
            isActiveRole('student')
            && resource.data.studentId == request.auth.uid
          )
        );

      allow create: if isFaculty()
        && request.resource.data.facultyId == request.auth.uid
        && request.resource.data.attendanceStatus == 'present'
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'active'
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.facultyId == request.auth.uid;

      allow update: if false;
      allow delete: if false;
    }

    match /counters/{documentId} {
      allow read, write: if isActiveRole('admin');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
